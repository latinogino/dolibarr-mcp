# Dolibarr Configuration
# Use a dedicated Dolibarr user with the minimum permissions needed.
DOLIBARR_URL=https://your-dolibarr.example.com/api/index.php
DOLIBARR_API_KEY=YOUR_API_KEY_HERE

# Logging
LOG_LEVEL=INFO

# MCP HTTP listener (recommended for Docker Compose)
MCP_TRANSPORT=http
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8080
MCP_HOST_PORT=18004
# Host interface published by Docker Compose (keep 127.0.0.1 unless behind a VPN/reverse proxy)
MCP_BIND_ADDRESS=127.0.0.1

# Security
# Bearer token required by the HTTP listener. Generate with: openssl rand -hex 32
# Mandatory when MCP_HTTP_HOST is not a loopback address (always the case in Docker).
MCP_HTTP_TOKEN=
# Comma-separated allowed CORS origins (empty = CORS disabled)
MCP_CORS_ORIGINS=
# true = only read tools are exposed (no create/update/delete/validate)
MCP_READ_ONLY=false
# true = expose the dolibarr_raw_api tool (arbitrary Dolibarr API calls)
MCP_ENABLE_RAW_API=false

# Docker Compose naming
MCP_CONTAINER_NAME=dolibarr-mcp-server
MCP_NETWORK_NAME=dolibarr-mcp-net
MCP_NETWORK_EXTERNAL=false
